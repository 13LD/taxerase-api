<% content_for :title, "Taxerase | Resend confirmation" %>

<main class="page-shell auth-page-shell">
  <section class="liquid-card auth-card">
    <div class="section-head">
      <div>
        <p class="section-kicker">Email confirmation</p>
        <h2>Resend confirmation</h2>
        <p class="section-note">Request a new confirmation link for the email address on your Taxerase account.</p>
      </div>
    </div>

    <%= render "devise/shared/error_messages", resource: resource %>

    <%= form_for(resource, as: resource_name, url: confirmation_path(resource_name), html: { method: :post, class: "auth-form" }) do |f| %>
      <div class="field">
        <%= f.label :email, class: "field-label" %>
        <div class="input-shell">
          <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "name@example.com" %>
        </div>
      </div>

      <%= f.submit "Resend confirmation email", class: "primary-action" %>
    <% end %>

    <%= render "devise/shared/links" %>
  </section>
</main>
