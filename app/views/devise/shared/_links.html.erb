<div class="auth-link-row">
  <% if controller_name != "sessions" %>
    <span>Already registered? <%= link_to "Sign in", new_session_path(resource_name, return_to: auth_return_to_param) %></span>
  <% end %>

  <% if devise_mapping.registerable? && controller_name != "registrations" %>
    <span>No account yet? <%= link_to "Create one", new_registration_path(resource_name, return_to: auth_return_to_param) %></span>
  <% end %>

  <% if devise_mapping.recoverable? && controller_name == "sessions" %>
    <%= link_to "Forgot password?", new_password_path(resource_name) %>
  <% end %>

  <% if devise_mapping.confirmable? && controller_name == "sessions" %>
    <%= link_to "Resend confirmation", new_confirmation_path(resource_name) %>
  <% end %>
</div>
