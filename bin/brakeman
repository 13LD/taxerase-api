#!/usr/bin/env ruby
require "rubygems"
require "bundler/setup"

ensure_latest_added = !ARGV.any? { |argument| argument == "--ensure-latest" }
ARGV.unshift("--ensure-latest") if ensure_latest_added

begin
  load Gem.bin_path("brakeman", "brakeman")
rescue NoMethodError => error
  raise unless ensure_latest_added &&
    error.name == :date &&
    error.backtrace&.any? { |line| line.include?("brakeman.rb") && line.include?("ensure_latest") }

  ARGV.delete("--ensure-latest")
  warn "Brakeman latest-version check failed; retrying scan without --ensure-latest."
  load Gem.bin_path("brakeman", "brakeman")
end
